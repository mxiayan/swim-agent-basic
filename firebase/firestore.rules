rules_version = '2';
// Deploy: cd firebase && firebase deploy --only firestore:rules
// (Uses `firebase login`, not GOOGLE_APPLICATION_CREDENTIALS.)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function monitoredMeetLocationOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'location_address',
        'venue_id',
        'location_source',
        'last_updated',
      ]);
    }

    // Path for DocumentReference owner_id (FlutterFlow: users/{uid})
    function userDocumentPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function swimmerOwnerMatches() {
      return signedIn() && (
        resource.data.owner_id == userDocumentPath()
        || resource.data.owner_id == request.auth.uid
      );
    }

    function swimmerCreateOwnerMatches() {
      return signedIn() && (
        request.resource.data.owner_id == userDocumentPath()
        || request.resource.data.owner_id == request.auth.uid
      );
    }

    // --- Swim Agent: swimmer profile + zone hydration merge ---
    // Flutter resolves profile with swimmers/{authUid}.get() first; that doc often
    // does NOT exist (auto-id docs + owner_id → users/{uid}). Rules must allow
    // "missing doc" reads or the client gets permission-denied and never runs
    // the owner_id query (Meets banner stays empty).
    match /swimmers/{swimmerId} {
      allow read: if signedIn() && (
        !resource.exists
        || swimmerOwnerMatches()
      );
      allow create: if swimmerCreateOwnerMatches();
      allow update: if swimmerOwnerMatches()
        && request.resource.data.owner_id == resource.data.owner_id;
      allow delete: if false;
    }

    // User account document (matches owner_id reference target)
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId;

      // Per-user subcollections (paths: users/{uid}/…)
      match /entered_meets/{document} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /hidden_meets/{document} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /meet_preferences/{document} {
        allow read, write: if signedIn() && request.auth.uid == userId;

        match /personal_resources/{resourceId} {
          allow read, write: if signedIn() && request.auth.uid == userId;
        }
      }
    }

    // Club → zone lookup (read-only from client; use Admin or Console for writes)
    match /metadata_clubs/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Polymorphic calendar events written by the swim-coach-parser Cloud Run
    // service. Client reads only; the parser uses the Admin SDK so it
    // bypasses these rules for writes.
    match /team_events/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Quarantined inbound emails: backend-only, never exposed to clients.
    match /team_events_quarantine/{docId} {
      allow read, write: if false;
    }

    // Meets feed (read-only from client; backend/Admin for writes)
    match /monitored_meets/{docId} {
      allow read: if signedIn();
      // Allow users to verify venue/address only; scraper/feed fields stay locked.
      allow update: if signedIn()
        && monitoredMeetLocationOnlyUpdate()
        && request.resource.data.location_source in ['scraper', 'user_verified', 'ai_matched'];
      allow create, delete: if false;
    }

    // Venue directory (meet detail picker; hydrate via Admin / tool)
    match /venues/{venueId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Legacy / FlutterFlow sample collections ---
    match /teams/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /activities/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /groups/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /monitored_meets/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /users/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if false;
    }

    match /swimmers/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if false;
    }

    match /metadata_regions/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /metadata_groups/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /metadata_clubs/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }
  }
}
